<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fleetdeck.app til macOS: ikon i menulinjen + installationsvindue (Avalonia), krydskompileret på Linux til osx-arm64 og osx-x64.
       src/Fleetdeck.MacPack laver .app-pakken, signerer den ad hoc og bygger disk-imaget (DMG). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(FleetdeckLegacy)' == 'true'">net8.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Fleetdeck.MacApp</RootNamespace>
    <AssemblyName>Fleetdeck</AssemblyName>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <!-- én fil i Contents/MacOS: de native biblioteker (Avalonia, Skia) pakkes ud ved første start, så kun hovedprogrammet skal signeres -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- færdigoversat kode (ReadyToRun) til Avalonia og appen: langt mindre JIT ved start – mærkes mest på ældre Intel-Mac'er -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <ApplicationIcon />
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fleetdeck.Shared\Fleetdeck.Shared.csproj" />
  </ItemGroup>
</Project>
